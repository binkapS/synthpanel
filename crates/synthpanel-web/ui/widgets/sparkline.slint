import { Theme } from "theme.slint";

// A tiny SVG sparkline. The path is built in Rust (see `sparkline_path`) so
// the Slint side stays declarative.
export component Sparkline inherits Rectangle {
    in property <string> path;
    in property <string> empty-text: "not enough data";
    in property <length> chart-height: 120px;

    height: root.chart-height;
    border-radius: 8px;
    background: transparent;

    if root.path == "" : Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        Text {
            text: root.empty-text;
            font-size: 12px;
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.path != "" : Path {
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.path;
        stroke: Theme.accent;
        stroke-width: 2px;
        fill: transparent;
    }
}
