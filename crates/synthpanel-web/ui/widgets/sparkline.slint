import { Theme } from "theme.slint";

// A tiny SVG sparkline. The path is built in Rust (see `sparkline_path`) so
// the Slint side stays declarative.
export component Sparkline inherits Rectangle {
    in property <string> path;
    in property <string> empty-text: "not enough data";
    in property <length> chart-height: 120px;

    height: root.chart-height;
    vertical-stretch: 0;
    border-radius: 8px;
    background: transparent;
    clip: true;
    accessible-role: image;
    accessible-label: "Trend chart";
    accessible-description: root.path == "" ? root.empty-text : "Line chart of recent values";

    if root.path == "" : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.empty-text;
                font-size: 12px;
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }

    if root.path != "" : Path {
        // Without an explicit size the path keeps its implicit size instead
        // of scaling to the chart area.
        width: 100%;
        height: 100%;
        viewbox-width: 300;
        viewbox-height: 100;
        commands: root.path;
        stroke: Theme.accent;
        stroke-width: 2px;
        fill: transparent;
    }
}
