import { CheckBox, ComboBox, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

// Shared geometry for the label / control / hint stack. All form controls use
// the same 32px input height and the same 6px rhythm so labels line up across
// a row of fields.
export component TextField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    in property <string> hint;
    callback accepted();

    spacing: 6px;
    vertical-stretch: 0;

    // The visible label and hint are part of the input's accessible name and
    // description: hide the standalone text nodes so screen readers announce
    // them once, together with the field they belong to.
    if root.label != "" : Text {
        text: root.label;
        font-size: 12px;
        font-weight: 500;
        color: Theme.muted;
        vertical-alignment: center;
        accessible-role: none;
    }

    LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder;
        input-type: root.password ? InputType.password : InputType.text;
        enabled: root.enabled;
        font-size: 13px;
        min-height: 32px;
        vertical-stretch: 0;
        accepted => root.accepted();
        accessible-label: root.label != "" ? root.label : root.placeholder;
        accessible-description: root.hint;
        accessible-enabled: root.enabled;
    }

    if root.hint != "" : Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.muted;
        wrap: word-wrap;
        accessible-role: none;
    }
}

export component TextArea inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <int> lines: 8;
    in property <bool> monospace: true;

    spacing: 6px;
    vertical-stretch: 0;

    if root.label != "" : Text {
        text: root.label;
        font-size: 12px;
        font-weight: 500;
        color: Theme.muted;
        vertical-alignment: center;
        accessible-role: none;
    }

    TextEdit {
        text <=> root.text;
        font-size: 12px;
        font-family: root.monospace ? "monospace" : "sans-serif";
        min-height: root.lines * 16px + 16px;
        vertical-stretch: 0;
        wrap: no-wrap;
        accessible-label: root.label;
    }
}

export component SelectField inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> index: 0;
    in property <bool> enabled: true;
    callback selected(string);

    spacing: 6px;
    vertical-stretch: 0;

    if root.label != "" : Text {
        text: root.label;
        font-size: 12px;
        font-weight: 500;
        color: Theme.muted;
        vertical-alignment: center;
        accessible-role: none;
    }

    ComboBox {
        model: root.options;
        current-index <=> root.index;
        enabled: root.enabled;
        min-height: 32px;
        vertical-stretch: 0;
        selected(value) => { root.selected(value); }
        accessible-label: root.label;
        accessible-enabled: root.enabled;
    }
}

export component Toggle inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> checked;
    spacing: 8px;
    alignment: start;
    vertical-stretch: 0;

    CheckBox {
        text: root.label;
        checked <=> root.checked;
        accessible-role: checkbox;
        accessible-label: root.label;
        accessible-checked: root.checked;
    }
}

export component TextInput inherits VerticalLayout {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback accepted();

    alignment: center;

    LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder-text;
        enabled: root.enabled;
        font-family: "monospace";
        font-size: 13px;
        min-height: 32px;
        vertical-stretch: 0;
        accepted => root.accepted();
        accessible-label: root.placeholder-text != "" ? root.placeholder-text : "Text input";
        accessible-enabled: root.enabled;
    }
}
