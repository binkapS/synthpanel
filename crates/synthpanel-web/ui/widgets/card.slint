import { Theme } from "theme.slint";

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> padded: true;

    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        if root.title != "" : Rectangle {
            height: 52px;
            // A fixed-size header must not take a share of the card's spare
            // height, otherwise the body is pushed down and clipped.
            vertical-stretch: 0;
            background: transparent;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    if root.subtitle != "" : Text {
                        text: root.subtitle;
                        font-size: 11px;
                        color: Theme.muted;
                        overflow: elide;
                    }
                }
            }
        }

        if root.title != "" : Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }

        Rectangle {
            background: transparent;
            VerticalLayout {
                padding: root.padded ? 16px : 0px;
                padding-bottom: root.padded ? 18px : 0px;
                spacing: 12px;
                // Content sits at the top of the card; spare height is never
                // spread between sections.
                alignment: start;
                @children
            }
        }
    }
}

export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 12px;
    alignment: space-between;
    // Headings keep their natural height in the page's vertical stack.
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.title;
            font-size: 24px;
            font-weight: 600;
            color: Theme.text;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            font-size: 13px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
}

export component Notice inherits Rectangle {
    in property <string> text;
    in property <string> kind: "error";
    visible: root.text != "";
    // An empty notice reserves no space at all - pages instantiate notices
    // unconditionally, so a hidden notice used to leave a permanent gap.
    height: root.text == "" ? 0px : text.preferred-height + 20px;
    vertical-stretch: 0;
    clip: true;
    border-radius: 8px;
    // Status/error messages arrive asynchronously from the bridge; expose
    // them as a labelled live region so changes are announced.
    // Qualified: the notice's child Text element is named `text`, which would
    // otherwise shadow the bare `text` role name.
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-live-region: root.kind == "error" ? assertive : polite;
    background: root.kind == "success"
        ? Theme.success-soft
        : (root.kind == "warning" ? Theme.warning-soft : Theme.danger-soft);
    border-width: 1px;
    border-color: root.kind == "success"
        ? Theme.success
        : (root.kind == "warning" ? Theme.warning : Theme.danger);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        text := Text {
            text: root.text;
            font-size: 12px;
            color: root.kind == "success"
                ? Theme.success
                : (root.kind == "warning" ? Theme.warning : Theme.danger);
            wrap: word-wrap;
            accessible-role: none;
        }
    }
}
