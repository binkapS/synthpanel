import { Theme } from "theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> status: "unknown";

    property <bool> good: root.status == "active" || root.status == "running"
        || root.status == "ok" || root.status == "enabled" || root.status == "delivered"
        || root.status == "succeeded" || root.status == "verified";
    property <bool> bad: root.status == "failed" || root.status == "error";

    // 8px + 6px dot + 5px gap + 8px = 27px of chrome around the label.
    width: label.preferred-width + 28px;
    height: 20px;
    // Badges are content-sized; they must not stretch in table rows.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 999px;
    background: root.good ? Theme.success-soft : (root.bad ? Theme.danger-soft : Theme.surface-muted);
    // Convey the status as labelled text instead of leaving a colour-only dot
    // and a bare word with no context in the accessibility tree.
    // Qualified to avoid any collision with a `text` element/property in
    // scope: `text` is a valid AccessibleRole value in Slint 1.19.
    accessible-role: AccessibleRole.text;
    accessible-label: "Status: " + root.status;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            cross-axis-self-alignment: center;
            border-radius: 3px;
            background: root.good ? Theme.success : (root.bad ? Theme.danger : Theme.warning);
        }
        label := Text {
            text: root.status;
            font-size: 11px;
            font-weight: 500;
            color: root.good ? Theme.success : (root.bad ? Theme.danger : Theme.muted);
            accessible-role: none;
        }
    }
}
