import { Theme } from "theme.slint";
import { AuditEntry } from "../types.slint";

export component AuditFeed inherits VerticalLayout {
    in property <[AuditEntry]> entries;
    spacing: 10px;

    if root.entries.length == 0 : Text {
        text: "No activity recorded yet.";
        font-size: 12px;
        color: Theme.muted;
    }

    for entry in root.entries : HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: Theme.accent;
            y: 7px;
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: entry.action + (entry.target != "" ? " · " + entry.target : "");
                font-size: 12px;
                font-weight: 500;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: entry.actor + (entry.ip != "" ? " · " + entry.ip : "") + " · " + entry.when;
                font-size: 10px;
                color: Theme.muted;
                overflow: elide;
            }
        }
    }
}
