import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppButton, IconButton } from "button.slint";
import { Page, Session } from "../types.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.surface-muted : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;
        Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            colorize: root.active ? Theme.accent : Theme.muted;
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.accent : Theme.muted;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => root.clicked();
    }

    accessible-role: button;
    accessible-label: root.label;
}

export component AppShell inherits Rectangle {
    in-out property <Page> current-page: Page.dashboard;
    in property <Session> session;
    in-out property <bool> dark: false;
    callback navigate(Page);
    callback toggle-theme();
    callback logout();

    background: Theme.bg;

    HorizontalLayout {
        spacing: 0px;

        // Sidebar
        Rectangle {
            width: 232px;
            background: Theme.surface;
            border-width: 0px;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 64px;
                    background: transparent;
                    HorizontalLayout {
                        padding-left: 18px;
                        spacing: 10px;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.accent-strong;
                            Text {
                                text: "SP";
                                font-size: 11px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: "SynthPanel";
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;

                        NavItem { label: "Dashboard"; icon: @image-url("../assets/icons/dashboard.svg"); active: root.current-page == Page.dashboard; clicked => root.navigate(Page.dashboard); }
                        NavItem { label: "Sites"; icon: @image-url("../assets/icons/globe.svg"); active: root.current-page == Page.sites || root.current-page == Page.site-detail; clicked => root.navigate(Page.sites); }
                        NavItem { label: "Databases"; icon: @image-url("../assets/icons/database.svg"); active: root.current-page == Page.databases; clicked => root.navigate(Page.databases); }
                        NavItem { label: "PHP"; icon: @image-url("../assets/icons/server.svg"); active: root.current-page == Page.php; clicked => root.navigate(Page.php); }
                        NavItem { label: "Security"; icon: @image-url("../assets/icons/shield.svg"); active: root.current-page == Page.security; clicked => root.navigate(Page.security); }
                        NavItem { label: "Backups"; icon: @image-url("../assets/icons/archive.svg"); active: root.current-page == Page.backups; clicked => root.navigate(Page.backups); }
                        NavItem { label: "Cron"; icon: @image-url("../assets/icons/clock.svg"); active: root.current-page == Page.cron; clicked => root.navigate(Page.cron); }
                        NavItem { label: "Logs"; icon: @image-url("../assets/icons/scroll.svg"); active: root.current-page == Page.logs; clicked => root.navigate(Page.logs); }
                        NavItem { label: "Files"; icon: @image-url("../assets/icons/folder.svg"); active: root.current-page == Page.files; clicked => root.navigate(Page.files); }
                        NavItem { label: "Deployments"; icon: @image-url("../assets/icons/git-branch.svg"); active: root.current-page == Page.deployments; clicked => root.navigate(Page.deployments); }
                        NavItem { label: "Alerts"; icon: @image-url("../assets/icons/bell.svg"); active: root.current-page == Page.alerts; clicked => root.navigate(Page.alerts); }
                        NavItem { label: "Terminal"; icon: @image-url("../assets/icons/terminal.svg"); active: root.current-page == Page.terminal; clicked => root.navigate(Page.terminal); }
                        NavItem { label: "Users"; icon: @image-url("../assets/icons/users.svg"); active: root.current-page == Page.users; clicked => root.navigate(Page.users); }
                        NavItem { label: "Settings"; icon: @image-url("../assets/icons/settings.svg"); active: root.current-page == Page.settings; clicked => root.navigate(Page.settings); }
                    }
                }
            }
        }

        // Main column
        Rectangle {
            background: transparent;
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 64px;
                    background: Theme.surface;
                    border-width: 0px;
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;
                        Text {
                            text: "Live server overview";
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        IconButton {
                            icon: root.dark ? @image-url("../assets/icons/sun.svg") : @image-url("../assets/icons/moon.svg");
                            tooltip: root.dark ? "Switch to light theme" : "Switch to dark theme";
                            clicked => root.toggle-theme();
                        }
                        Text {
                            text: root.session.name;
                            font-size: 13px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: role.preferred-width + 16px;
                            height: 20px;
                            border-radius: 999px;
                            background: Theme.surface-muted;
                            role := Text {
                                text: root.session.role;
                                font-size: 10px;
                                font-weight: 500;
                                color: Theme.muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        IconButton {
                            icon: @image-url("../assets/icons/logout.svg");
                            tooltip: "Sign out";
                            clicked => root.logout();
                        }
                    }
                }

                Rectangle {
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 22px;
                        spacing: 18px;
                        @children
                    }
                }
            }
        }
    }
}
