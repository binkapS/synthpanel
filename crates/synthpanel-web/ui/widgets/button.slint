import { Theme } from "theme.slint";

// A TouchArea alone is invisible to keyboard and assistive-technology users.
// Mirror Slint's own FocusTouchArea: a zero-sized FocusScope handles Space /
// Enter while the TouchArea keeps the mouse behaviour and pointer cursor.
// `forward-focus` makes a pointer click move keyboard focus to the scope too.
component FocusButtonArea inherits Rectangle {
    in property <bool> enabled: true;
    out property <bool> pressed <=> area.pressed;
    out property <bool> has-hover <=> area.has-hover;
    out property <bool> has-focus <=> focus.has-focus;
    callback clicked <=> area.clicked;

    forward-focus: focus;

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
    }

    focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                area.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 34px;
    width: label.preferred-width + 24px;
    // Buttons are content-sized: without this they inherit the layout's
    // default stretch, so a row of buttons all become different widths and a
    // button in a form grows to the full height of the form.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.primary
        ? (root.enabled ? Theme.accent-strong : Theme.border)
        : Theme.border;
    background: !root.enabled
        ? Theme.surface-muted
        : (root.danger ? Theme.danger-soft : (root.primary ? Theme.accent-strong : Theme.surface));
    opacity: root.enabled ? 1 : 0.7;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        label := Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            color: !root.enabled
                ? Theme.muted
                : (root.primary ? #ffffff : (root.danger ? Theme.danger : Theme.text));
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := FocusButtonArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.danger ? "Destructive action" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { ta.clicked(); }
    forward-focus: ta;

    states [
        hovered when ta.has-hover && root.enabled && !root.primary: {
            background: root.danger ? Theme.danger-soft : Theme.surface-muted;
        }
        primary-hovered when ta.has-hover && root.enabled && root.primary: {
            background: Theme.accent;
        }
        pressed when ta.pressed && root.enabled: {
            opacity: 0.85;
        }
        focused when ta.has-focus && root.enabled: {
            border-width: 2px;
            border-color: Theme.accent;
        }
    ]
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    width: 34px;
    height: 34px;
    // Icon buttons are fixed-size; the default stretch made them balloon in
    // the header and in table rows.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: root.danger ? Theme.danger-soft : Theme.surface;
    opacity: root.enabled ? 1 : 0.6;

    // An Image keeps its intrinsic size, so it needs a pair of layouts to be
    // centred on both axes of the 34x34 button.
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                horizontal-stretch: 0;
                vertical-stretch: 0;
                colorize: root.danger ? Theme.danger : Theme.muted;
            }
        }
    }

    ta := FocusButtonArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-description: root.danger ? "Destructive action" : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { ta.clicked(); }
    forward-focus: ta;

    states [
        hovered when ta.has-hover && root.enabled: {
            background: root.danger ? Theme.danger-soft : Theme.surface-muted;
        }
        focused when ta.has-focus && root.enabled: {
            border-width: 2px;
            border-color: Theme.accent;
        }
    ]
}
