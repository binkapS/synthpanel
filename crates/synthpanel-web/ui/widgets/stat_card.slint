import { Theme } from "theme.slint";

export component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> hint;
    in property <image> icon;

    min-height: 92px;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: Theme.accent-soft;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: Theme.accent;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.label;
                font-size: 11px;
                font-weight: 600;
                color: Theme.muted;
                letter-spacing: 0.6px;
            }
            Text {
                text: root.value;
                font-size: 21px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if root.hint != "" : Text {
                text: root.hint;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
            }
        }
    }
}
