import { Theme } from "theme.slint";
import { StatusBadge } from "status_badge.slint";
import { Service } from "../types.slint";

export component ServiceList inherits VerticalLayout {
    in property <[Service]> services;
    spacing: 0px;

    if root.services.length == 0 : Text {
        text: "No service information available.";
        font-size: 12px;
        color: Theme.muted;
    }

    for service in root.services : Rectangle {
        height: 32px;
        background: transparent;
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            Text {
                text: service.unit;
                font-family: "monospace";
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
                vertical-alignment: center;
            }
            StatusBadge { status: service.status; }
        }
    }
}
