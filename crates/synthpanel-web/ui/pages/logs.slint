import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader, Notice } from "../widgets/card.slint";
import { AppButton } from "../widgets/button.slint";
import { TextField } from "../widgets/field.slint";
import { LogSource, LogLine } from "../types.slint";

export component LogsPage inherits Rectangle {
    in-out property <[LogSource]> sources;
    in-out property <[LogLine]> lines;
    in-out property <string> active-source;
    in-out property <string> status;

    private property <string> search-text: "";

    callback source-changed(string);
    callback search-changed(string);

    vertical-stretch: 0;

    accessible-role: region;
    accessible-label: "Logs";

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        PageHeader {
            title: "Logs";
            subtitle: "Filter nginx, PHP-FPM, panel and system logs.";
        }

        if root.status != "" : Notice { text: root.status; }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 0;

            Card {
                title: "Sources";
                width: 240px;
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 0;
                    for source in root.sources : AppButton {
                        text: source.label;
                        primary: source.id == root.active-source;
                        enabled: source.available;
                        clicked => { root.source-changed(source.id); }
                    }
                    TextField {
                        label: "Search";
                        text <=> root.search-text;
                        placeholder: "filter the tail";
                        accepted => { root.search-changed(root.search-text); }
                    }
                }
            }

            Card {
                title: root.active-source == "" ? "Lines" : "Lines · " + root.active-source;
                horizontal-stretch: 1;
                vertical-stretch: 0;

                // The log tail is the only genuinely tall block on this page:
                // keep it inside a bounded, scrollable viewport instead of a
                // fixed 420px box that pushes the card off screen.
                Rectangle {
                    background: Theme.terminal-bg;
                    border-radius: 8px;
                    clip: true;
                    min-height: 280px;
                    max-height: 480px;
                    vertical-stretch: 0;

                    Flickable {
                        VerticalLayout {
                            alignment: start;
                            padding: 12px;
                            spacing: 2px;
                            vertical-stretch: 0;

                            if root.lines.length == 0 : Text {
                                text: "Select a source to read its tail.";
                                font-size: 12px;
                                color: Theme.terminal-text;
                            }

                            for line in root.lines : Text {
                                text: line.text;
                                font-family: "monospace";
                                font-size: 11px;
                                color: line.level == "error" ? Theme.danger : Theme.terminal-text;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
