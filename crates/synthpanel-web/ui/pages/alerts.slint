import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader, Notice } from "../widgets/card.slint";
import { AppButton, IconButton } from "../widgets/button.slint";
import { TextField } from "../widgets/field.slint";
import { StatusBadge } from "../widgets/status_badge.slint";
import { ChannelRow, AlertRuleRow, AlertRow } from "../types.slint";

export component AlertsPage inherits Rectangle {
    accessible-role: region;
    accessible-label: "Alerts page";

    in-out property <[ChannelRow]> channels;
    in-out property <[AlertRuleRow]> rules;
    in-out property <[AlertRow]> alerts;
    in-out property <string> status;

    private property <string> channel-name: "";
    private property <string> channel-kind: "webhook";
    private property <string> channel-url: "";
    private property <string> channel-to: "";
    private property <string> channel-host: "";

    private property <string> rule-name: "";
    private property <string> rule-event: "service.down";
    private property <string> rule-severity: "warning";
    private property <string> rule-channel: "";

    callback create-channel(string, string, string, string, string);
    callback delete-channel(string);
    callback create-rule(string, string, string, string, int);
    callback delete-rule(string);
    callback test-alert(string, string);

    vertical-stretch: 0;

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        PageHeader {
            title: "Alerts";
            subtitle: "Notify by email or webhook when something needs attention.";
        }

        if root.status != "" : Notice { text: root.status; }

        // The two creation forms share a row so neither ends up stranded at
        // the bottom of a long column.
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 0;

            Card {
                title: "New channel";
                horizontal-stretch: 1;
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 0;
                    TextField {
                        label: "Name";
                        text <=> root.channel-name;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        TextField {
                            label: "Kind";
                            text <=> root.channel-kind;
                            hint: "webhook or email";
                            horizontal-stretch: 1;
                        }
                        TextField {
                            label: "SMTP host";
                            text <=> root.channel-host;
                            horizontal-stretch: 1;
                        }
                    }
                    TextField {
                        label: "URL / To";
                        text <=> root.channel-url;
                        hint: "Webhook URL or recipient address.";
                    }
                    TextField {
                        label: "Recipient (email)";
                        text <=> root.channel-to;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        AppButton {
                            text: "Add channel";
                            primary: true;
                            clicked => { root.create-channel(root.channel-name, root.channel-kind, root.channel-url, root.channel-to, root.channel-host); }
                        }
                    }
                }
            }

            Card {
                title: "New rule";
                horizontal-stretch: 1;
                vertical-stretch: 0;
                VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 0;
                    TextField {
                        label: "Name";
                        text <=> root.rule-name;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        TextField {
                            label: "Event";
                            text <=> root.rule-event;
                            horizontal-stretch: 1;
                        }
                        TextField {
                            label: "Severity";
                            text <=> root.rule-severity;
                            horizontal-stretch: 1;
                        }
                    }
                    TextField {
                        label: "Channel id";
                        text <=> root.rule-channel;
                        hint: "Leave empty to notify every channel.";
                    }
                    Text {
                        text: "Cooldown: 900 seconds";
                        font-size: 11px;
                        color: Theme.muted;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        AppButton {
                            text: "Add rule";
                            primary: true;
                            clicked => { root.create-rule(root.rule-name, root.rule-event, root.rule-severity, root.rule-channel, 900); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 0;

            Card {
                title: "Channels";
                subtitle: root.channels.length.to-fixed(0) + " configured";
                horizontal-stretch: 1;
                vertical-stretch: 0;
                Flickable {
                    max-height: 320px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        vertical-stretch: 0;
                        if root.channels.length == 0 : Text {
                            text: "No channels configured.";
                            font-size: 12px;
                            color: Theme.muted;
                        }
                        for channel in root.channels : HorizontalLayout {
                            height: 34px;
                            spacing: 12px;
                            Text {
                                text: channel.name;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: channel.kind;
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            IconButton {
                                icon: @image-url("../assets/icons/play.svg");
                                tooltip: "Send test alert to " + channel.name;
                                clicked => { root.test-alert(channel.id, "SynthPanel test alert"); }
                            }
                            IconButton {
                                icon: @image-url("../assets/icons/trash.svg");
                                tooltip: "Delete channel " + channel.name;
                                danger: true;
                                clicked => { root.delete-channel(channel.id); }
                            }
                        }
                    }
                }
            }

            Card {
                title: "Rules";
                subtitle: root.rules.length.to-fixed(0) + " configured";
                horizontal-stretch: 1;
                vertical-stretch: 0;
                Flickable {
                    max-height: 320px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        vertical-stretch: 0;
                        if root.rules.length == 0 : Text {
                            text: "No rules configured.";
                            font-size: 12px;
                            color: Theme.muted;
                        }
                        for rule in root.rules : HorizontalLayout {
                            height: 34px;
                            spacing: 12px;
                            Text {
                                text: rule.name;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: rule.event;
                                font-size: 11px;
                                color: Theme.muted;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            StatusBadge { status: rule.severity; }
                            IconButton {
                                icon: @image-url("../assets/icons/trash.svg");
                                tooltip: "Delete rule " + rule.name;
                                danger: true;
                                clicked => { root.delete-rule(rule.id); }
                            }
                        }
                    }
                }
            }
        }

        Card {
            title: "Fired alerts";
            vertical-stretch: 0;
            Flickable {
                max-height: 280px;
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    vertical-stretch: 0;
                    if root.alerts.length == 0 : Text {
                        text: "Nothing has fired yet.";
                        font-size: 12px;
                        color: Theme.muted;
                    }
                    for alert in root.alerts : HorizontalLayout {
                        height: 34px;
                        spacing: 12px;
                        Text {
                            text: alert.event;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        StatusBadge { status: alert.status; }
                        Text {
                            text: alert.message;
                            font-size: 11px;
                            color: Theme.muted;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
