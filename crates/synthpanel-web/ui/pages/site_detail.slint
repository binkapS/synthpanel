import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader, Notice } from "../widgets/card.slint";
import { AppButton } from "../widgets/button.slint";
import { SiteDetail, SslStatus } from "../types.slint";

export component SiteDetailPage inherits Rectangle {
    in property <string> id;
    in-out property <SiteDetail> detail;
    in-out property <SslStatus> ssl;
    in-out property <string> error;
    in-out property <string> ssl-message;

    callback site-action(string, string);
    callback site-ssl(string);
    callback back();

    VerticalLayout {
        spacing: 18px;

        HorizontalLayout {
            alignment: space-between;
            PageHeader {
                title: root.detail.domain;
                subtitle: root.detail.id;
            }
            AppButton {
                text: "Back to sites";
                clicked => { root.back(); }
            }
        }

        Notice { text: root.error; }
        Notice { text: root.ssl-message; kind: "success"; }

        HorizontalLayout {
            spacing: 16px;

            Card {
                title: "Overview";
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Template: " + root.detail.template; font-size: 12px; color: Theme.text; }
                    Text { text: "PHP: " + (root.detail.php-version == "" ? "—" : root.detail.php-version); font-size: 12px; color: Theme.text; }
                    Text { text: "Document root: " + root.detail.document-root; font-size: 12px; color: Theme.text; }
                    Text { text: "Pool user: " + root.detail.pool-user; font-size: 12px; color: Theme.text; }
                    Text { text: "Aliases: " + (root.detail.aliases == "" ? "—" : root.detail.aliases); font-size: 12px; color: Theme.text; }
                    Text { text: "Status: " + root.detail.status; font-size: 12px; color: Theme.text; }
                }
            }

            Card {
                title: "SSL";
                horizontal-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Mode: " + root.ssl.ssl-mode; font-size: 12px; color: Theme.text; }
                    Text { text: "Expires: " + (root.ssl.expires == "" ? "—" : root.ssl.expires); font-size: 12px; color: Theme.text; }
                    if root.ssl.expiring-soon : Text {
                        text: "This certificate expires soon.";
                        font-size: 11px;
                        color: Theme.warning;
                    }
                    AppButton {
                        text: "Issue certificate";
                        primary: true;
                        clicked => { root.site-ssl(root.id); }
                    }
                }
            }
        }

        Card {
            title: "Lifecycle";
            HorizontalLayout {
                spacing: 10px;
                AppButton {
                    text: root.detail.status == "active" ? "Suspend" : "Unsuspend";
                    clicked => { root.site-action(root.id, root.detail.status == "active" ? "suspend" : "unsuspend"); }
                }
                AppButton {
                    text: "Delete site";
                    danger: true;
                    clicked => { root.site-action(root.id, "delete"); }
                }
            }
        }
    }
}
