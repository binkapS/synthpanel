import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader, Notice } from "../widgets/card.slint";
import { AppButton, IconButton } from "../widgets/button.slint";
import { TextField } from "../widgets/field.slint";
import { TextEdit } from "std-widgets.slint";
import { FileRow } from "../types.slint";

export component FilesPage inherits Rectangle {
    accessible-role: region;
    accessible-label: "Files page";

    in-out property <[FileRow]> rows;
    in-out property <string> path;
    in-out property <string> status;
    in-out property <string> content;

    private property <bool> editing: false;
    private property <bool> modified: false;
    private property <string> scope: "www";
    private property <string> new-name: "";

    callback path-changed(string);
    callback file-write(string, string, string);
    callback file-mkdir(string, string);
    callback file-delete(string, string);
    callback file-renamed(string, string, string);
    callback file-chmod(string, string, string);
    callback file-content(string, string);
    // Upload: (scope, directory, base64). An empty base64 makes the JS bridge
    // open a file picker and upload the chosen file into `directory`.
    callback file-upload(string, string, string);
    // Copy: (scope, source path, destination path).
    callback file-copy(string, string, string);

    vertical-stretch: 0;

    VerticalLayout {
        alignment: start;
        spacing: 18px;

        PageHeader {
            title: "Files";
            subtitle: "Browse, edit and upload files inside managed directories.";
        }

        if root.status != "" : Notice { text: root.status; }

        // Breadcrumb on the left, actions grouped on the right.
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 0;
            Text {
                text: root.path == "" ? "/" : root.path;
                font-size: 13px;
                font-family: "monospace";
                color: Theme.muted;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            AppButton {
                text: "Parent";
                clicked => { root.path-changed(""); }
            }
            AppButton {
                text: root.editing ? "Hide editor" : "New file";
                clicked => {
                    root.editing = !root.editing;
                    root.modified = false;
                }
            }
            AppButton {
                text: "Upload";
                clicked => { root.file-upload(root.scope, root.path, ""); }
            }
        }

        if root.editing : Card {
            title: "Edit file";
            vertical-stretch: 0;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    TextField {
                        label: "Name";
                        text <=> root.new-name;
                        horizontal-stretch: 2;
                    }
                    AppButton {
                        text: "New folder";
                        clicked => {
                            root.file-mkdir(root.scope, root.path + "/" + root.new-name);
                            root.new-name = "";
                        }
                    }
                }
                Text {
                    text: "Content";
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.muted;
                    vertical-stretch: 0;
                    accessible-role: none;
                }
                // Editor surface: a non-interactive Flickable mirrors the
                // TextEdit's scroll offset so the line numbers stay aligned.
                Rectangle {
                    min-height: 12 * 18px + 12px;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 4px;
                    clip: true;
                    vertical-stretch: 0;
                    HorizontalLayout {
                        spacing: 0px;
                        Flickable {
                            width: 46px;
                            interactive: false;
                            content-y: editor.content-y;
                            Rectangle {
                                width: 100%;
                                height: max(editor.content-height, editor.height);
                                background: Theme.surface-muted;
                                // Slint has no text tokenizer/split(); a fixed
                                // set of rows keeps the gutter dependency-free.
                                for n in 256 : Text {
                                    x: 4px;
                                    y: n * 18px;
                                    width: parent.width - 8px;
                                    height: 18px;
                                    text: "\{n + 1}";
                                    font-family: "monospace";
                                    font-size: 11px;
                                    color: Theme.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        editor := TextEdit {
                            text <=> root.content;
                            font-family: "monospace";
                            font-size: 13px;
                            wrap: no-wrap;
                            min-height: 12 * 18px + 12px;
                            vertical-stretch: 0;
                            accessible-label: "Content";
                            edited(text) => { root.modified = true; }
                        }
                    }
                }
                if root.modified : HorizontalLayout {
                    spacing: 6px;
                    vertical-stretch: 0;
                    Text {
                        text: "●";
                        font-size: 11px;
                        color: Theme.warning;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Text {
                        text: "Modified (unsaved changes)";
                        font-size: 11px;
                        color: Theme.warning;
                        vertical-stretch: 0;
                        accessible-label: "File has unsaved changes";
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    AppButton {
                        text: "Cancel";
                        clicked => { root.editing = false; }
                    }
                    AppButton {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.file-write(root.scope, root.path + "/" + root.new-name, root.content);
                            root.modified = false;
                            root.editing = false;
                        }
                    }
                }
            }
        }

        Card {
            title: "Entries";
            subtitle: root.rows.length.to-fixed(0) + " items";
            vertical-stretch: 0;
            Flickable {
                max-height: 440px;
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;
                    vertical-stretch: 0;

                    if root.rows.length == 0 : Text {
                        text: "Nothing here yet.";
                        font-size: 12px;
                        color: Theme.muted;
                    }
                    for entry in root.rows : HorizontalLayout {
                        height: 34px;
                        spacing: 12px;
                        Text {
                            text: entry.name;
                            font-size: 13px;
                            font-family: "monospace";
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 2;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.is-directory ? "dir" : entry.size-label;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.mode;
                            font-size: 11px;
                            font-family: "monospace";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: entry.owner;
                            font-size: 11px;
                            color: Theme.muted;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        if entry.is-directory : AppButton {
                            text: "Open";
                            clicked => { root.path-changed(entry.path); }
                        }
                        if !entry.is-directory : IconButton {
                            icon: @image-url("../assets/icons/refresh.svg");
                            tooltip: "Open " + entry.name + " in editor";
                            clicked => {
                                root.modified = false;
                                root.file-content(root.scope, entry.path);
                            }
                        }
                        IconButton {
                            icon: @image-url("../assets/icons/plus.svg");
                            tooltip: "Duplicate " + entry.name;
                            clicked => { root.file-copy(root.scope, entry.path, entry.path + "-copy"); }
                        }
                        IconButton {
                            icon: @image-url("../assets/icons/trash.svg");
                            tooltip: (entry.is-directory ? "Delete folder " : "Delete file ") + entry.name;
                            danger: true;
                            clicked => { root.file-delete(root.scope, entry.path); }
                        }
                    }
                }
            }
        }
    }
}
