import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader } from "../widgets/card.slint";

export component PlaceholderPage inherits VerticalLayout {
    accessible-role: region;
    accessible-label: "Coming soon page";

    in property <string> title: "Coming soon";
    in property <string> description: "This area is not implemented yet.";

    spacing: 18px;

    PageHeader { title: root.title; subtitle: root.description; }

    Card {
        title: "Planned for a later milestone";
        Text {
            text: "This area is wired up in a later phase of the SynthPanel migration. The REST API and the privileged core already expose the primitives it builds on.";
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
}
