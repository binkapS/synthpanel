import { Theme } from "../widgets/theme.slint";
import { Card, PageHeader, Notice } from "../widgets/card.slint";
import { AppButton, IconButton } from "../widgets/button.slint";
import { TextField } from "../widgets/field.slint";
import { StatusBadge } from "../widgets/status_badge.slint";
import { BackupRow, ScheduleRow } from "../types.slint";

export component BackupsPage inherits Rectangle {
    accessible-role: region;
    accessible-label: "Backups page";

    in-out property <[BackupRow]> backups;
    in-out property <[ScheduleRow]> schedules;
    in-out property <string> status;

    private property <string> run-name: "";
    private property <string> run-kind: "full";
    private property <string> run-site: "";

    private property <string> sched-name: "";
    private property <string> sched-cron: "0 3 * * *";
    private property <string> sched-type: "local";
    private property <string> sched-path: "";
    private property <string> sched-site: "";

    callback run-backup(string, string, string);
    callback backup-action(string, string, string);
    callback delete-backup(string);
    callback create-schedule(string, string, string, string, string);
    callback delete-schedule(string);

    Flickable {
        VerticalLayout {
            alignment: start;
            spacing: 18px;

            PageHeader {
                title: "Backups";
                subtitle: "Archive, verify and restore server state.";
            }

            if root.status != "" : Notice { text: root.status; }

            HorizontalLayout {
                spacing: 16px;

                Card {
                    title: "Run a backup";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        TextField {
                            label: "Name";
                            text <=> root.run-name;
                            placeholder: "nightly";
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            TextField {
                                label: "Kind";
                                text <=> root.run-kind;
                                hint: "full or site";
                                horizontal-stretch: 1;
                            }
                            TextField {
                                label: "Site id";
                                text <=> root.run-site;
                                horizontal-stretch: 1;
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            AppButton {
                                text: "Run";
                                primary: true;
                                clicked => { root.run-backup(root.run-name, root.run-kind, root.run-site); }
                            }
                        }
                    }
                }

                Card {
                    title: "New schedule";
                    horizontal-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        TextField {
                            label: "Name";
                            text <=> root.sched-name;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            TextField {
                                label: "Cron";
                                text <=> root.sched-cron;
                                horizontal-stretch: 1;
                            }
                            TextField {
                                label: "Destination";
                                text <=> root.sched-type;
                                hint: "local or s3";
                                horizontal-stretch: 1;
                            }
                        }
                        TextField {
                            label: "Path";
                            text <=> root.sched-path;
                        }
                        TextField {
                            label: "Site id";
                            text <=> root.sched-site;
                            placeholder: "optional";
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            AppButton {
                                text: "Schedule";
                                primary: true;
                                clicked => { root.create-schedule(root.sched-name, root.sched-cron, root.sched-type, root.sched-path, root.sched-site); }
                            }
                        }
                    }
                }
            }

            Card {
                title: "Backups";
                VerticalLayout {
                    spacing: 0px;

                    HorizontalLayout {
                        padding-bottom: 8px;
                        spacing: 12px;
                        Text { text: "Name"; font-size: 11px; font-weight: 600; color: Theme.muted; horizontal-stretch: 1; min-width: 150px; }
                        Text { text: "Kind"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 80px; }
                        Text { text: "Status"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 100px; }
                        Text { text: "Size"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 90px; }
                        Text { text: "Flags"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 90px; }
                        Rectangle { width: 8px; }
                        Text { text: "Actions"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 120px; horizontal-alignment: center; }
                    }
                    Rectangle { height: 1px; background: Theme.border; }

                    if root.backups.length == 0 : HorizontalLayout {
                        padding-top: 12px;
                        Text {
                            text: "No backups yet.";
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }

                    for backup in root.backups : HorizontalLayout {
                        min-height: 40px;
                        spacing: 12px;
                        Text {
                            text: backup.name;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 150px;
                        }
                        Text {
                            text: backup.kind;
                            font-size: 11px;
                            color: Theme.muted;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            width: 100px;
                            alignment: start;
                            StatusBadge { status: backup.status; }
                        }
                        Text {
                            text: backup.size-label;
                            font-size: 11px;
                            color: Theme.muted;
                            width: 90px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: backup.encrypted ? "encrypted" : "";
                            font-size: 10px;
                            color: Theme.muted;
                            width: 90px;
                            vertical-alignment: center;
                        }
                        Rectangle { width: 8px; }
                        HorizontalLayout {
                            width: 120px;
                            spacing: 6px;
                            alignment: center;
                            IconButton {
                                icon: @image-url("../assets/icons/refresh.svg");
                                tooltip: "Verify backup " + backup.name;
                                clicked => { root.backup-action(backup.id, "verify", ""); }
                            }
                            IconButton {
                                icon: @image-url("../assets/icons/play.svg");
                                tooltip: "Restore backup " + backup.name;
                                clicked => { root.backup-action(backup.id, "restore", ""); }
                            }
                            IconButton {
                                icon: @image-url("../assets/icons/trash.svg");
                                tooltip: "Delete backup " + backup.name;
                                danger: true;
                                clicked => { root.delete-backup(backup.id); }
                            }
                        }
                    }
                }
            }

            Card {
                title: "Schedules";
                VerticalLayout {
                    spacing: 0px;

                    HorizontalLayout {
                        padding-bottom: 8px;
                        spacing: 12px;
                        Text { text: "Name"; font-size: 11px; font-weight: 600; color: Theme.muted; horizontal-stretch: 1; min-width: 150px; }
                        Text { text: "Cron"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 150px; }
                        Text { text: "Status"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 120px; }
                        Rectangle { width: 8px; }
                        Text { text: "Actions"; font-size: 11px; font-weight: 600; color: Theme.muted; width: 60px; horizontal-alignment: center; }
                    }
                    Rectangle { height: 1px; background: Theme.border; }

                    if root.schedules.length == 0 : HorizontalLayout {
                        padding-top: 12px;
                        Text {
                            text: "No schedules yet.";
                            font-size: 12px;
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }

                    for schedule in root.schedules : HorizontalLayout {
                        min-height: 40px;
                        spacing: 12px;
                        Text {
                            text: schedule.name;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            min-width: 150px;
                        }
                        Text {
                            text: schedule.cron;
                            font-size: 11px;
                            font-family: "monospace";
                            color: Theme.muted;
                            width: 150px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            width: 120px;
                            alignment: start;
                            StatusBadge { status: schedule.enabled ? "enabled" : "disabled"; }
                        }
                        Rectangle { width: 8px; }
                        HorizontalLayout {
                            width: 60px;
                            alignment: center;
                            IconButton {
                                icon: @image-url("../assets/icons/trash.svg");
                                tooltip: "Delete schedule " + schedule.name;
                                danger: true;
                                clicked => { root.delete-schedule(schedule.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
